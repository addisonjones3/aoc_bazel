load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

rust_library(
    name = "rust_2023_lib",
    srcs = glob(["src/**/*.rs"]),
    compile_data = ["Cargo.toml"],
    crate_name = "rust_2023",
    data = [
        "@aoc_files//2023:files",
    ],
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = [
        "//hack",
        "@crates//:anyhow",
        "@crates//:clap",
        "@crates//:iddqd",
        "@crates//:nom",
        "@crates//:nom_locate",
        "@crates//:num",
        "@crates//:runfiles",
    ],
)

rust_test(
    name = "rust_2023_lib_test",
    compile_data = ["Cargo.toml"],
    crate = ":rust_2023_lib",
    edition = "2024",
)

rust_binary(
    name = "rust_2023",
    srcs = ["src/main.rs"],
    compile_data = ["Cargo.toml"],
    edition = "2024",
    env = {},
    visibility = ["//visibility:public"],
    deps = [
        ":rust_2023_lib",
        "//hack",
        "@crates//:anyhow",
        "@crates//:clap",
    ],
)

rust_binary(
    name = "day1",
    compile_data = ["Cargo.toml"],
    edition = "2024",
    visibility = ["//visibility:public"],
)
