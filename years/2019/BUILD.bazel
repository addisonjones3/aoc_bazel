load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

exports_files(["Cargo.toml"])

rust_library(
    name = "rust_2019_lib",
    srcs = glob(["src/**/*.rs"]),
    compile_data = ["Cargo.toml"],
    crate_name = "rust_2019",
    data = [
        "@aoc_files//2019:files",
    ],
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = [
        "//hack",
        "@crates//:anyhow",
        "@crates//:clap",
        "@crates//:nom",
    ],
)

rust_test(
    name = "rust_2019_lib_test",
    compile_data = ["Cargo.toml"],
    crate = ":rust_2019_lib",
    edition = "2024",
)

rust_binary(
    name = "rust_2019",
    srcs = ["src/main.rs"],
    compile_data = ["Cargo.toml"],
    edition = "2024",
    env = {},
    visibility = ["//visibility:public"],
    deps = [
        ":rust_2019_lib",
        "//hack",
        "@crates//:anyhow",
        "@crates//:clap",
    ],
)
